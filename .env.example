# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Admin tools (local testing)
ADMIN_SECRET=dev-admin-secret
ADMIN_EMAILS=you@gmail.com

# ── Database ────────────────────────────────────────────────────────────────
# Recommended: PostgreSQL (works on Fly.io + local via docker compose)
#
# Local (after `docker compose up -d`):
STORE_DRIVER=json
# DATABASE_URL=postgresql://sorye:sorye@localhost:5432/sorye
#
# Local with Postgres store:
# STORE_DRIVER=postgres
# DATABASE_URL=postgresql://sorye:sorye@localhost:5432/sorye
#
# Fly.io (set via `fly secrets set`, not in this file):
#   STORE_DRIVER=postgres
#   DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Micro-frontend remote override (optional)
NEXT_PUBLIC_DASHBOARD_REMOTE=http://localhost:3001/remoteEntry.js
NEXT_PUBLIC_CALENDAR_REMOTE=http://localhost:3003/remoteEntry.js
NEXT_PUBLIC_NOTES_REMOTE=http://localhost:3004/remoteEntry.js
NEXT_PUBLIC_TASKS_REMOTE=http://localhost:3005/remoteEntry.js
NEXT_PUBLIC_RELAY_REMOTE=http://localhost:3006/remoteEntry.js
NEXT_PUBLIC_PROTOCOLIO_REMOTE=http://localhost:3007/remoteEntry.js
NEXT_PUBLIC_CANVAS_REMOTE=http://localhost:3008/remoteEntry.js
NEXT_PUBLIC_DEVKIT_REMOTE=http://localhost:3009/remoteEntry.js
NEXT_PUBLIC_MESSENGER_REMOTE=http://localhost:3010/remoteEntry.js
NEXT_PUBLIC_OCR_REMOTE=http://localhost:3011/remoteEntry.js

# Feature flags (local dev)
# Logs hub state to the browser console on user interactions.
NEXT_PUBLIC_FEATURE_SHOW_LOGS=false

# Embed widgets use AUTH_SECRET to sign short-lived iframe session tokens.
# Create keys in Hub → Connections → Embed widgets.

# Stripe (wire up when billing goes live)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
