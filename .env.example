# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret
# Leave AUTH_URL and NEXTAUTH_URL unset. Hub reconstructs the public origin per host, so
# customer and admin hosts each keep their own callback and host-only cookie. Production refuses both; locally AUTH_URL
# pins every sign-in to one origin and breaks Google sign-in on admin.localhost.
# AUTH_URL=http://localhost:3000
# Production behind Traefik/gateways only: Hub must be private and ingress must overwrite
# Host, X-Forwarded-Host and X-Forwarded-Proto. This asserts that boundary; it does not authenticate a proxy.
# AUTH_TRUST_HOST=true

# Hostnames. Production defaults: sorye.app and admin.sorye.app. Development admin host is
# admin.localhost:<port> (resolves to loopback without hosts-file edits). Unknown hosts get 421
# in production. SORYE_EXTRA_HOSTS adds customer aliases (comma-separated).
# SORYE_PUBLIC_HOST=sorye.app
# SORYE_ADMIN_HOST=admin.sorye.app
# SORYE_EXTRA_HOSTS=

# Local Hub without Google (recommended for `pnpm dev`).
# Production (Fly.io NODE_ENV=production) refuses this flag and still requires Google OAuth.
AUTH_DEV_BYPASS=true

# Google OAuth — required in production, and locally if AUTH_DEV_BYPASS is not true
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Admin tools (local testing)
ADMIN_SECRET=change-me-in-production-use-openssl-rand
# Platform administrators for the console at the admin host. Empty in production = nobody.
ADMIN_EMAILS=you@gmail.com

# ── Database ────────────────────────────────────────────────────────────────
# Copy Hub settings from this example to apps/hub/.env.local.
# This database is for remaining legacy Hub stores only. Rodrigo needs its own
# PostgreSQL configuration for identity, app records and storage (see below).
# Start/stop without deleting the persistent volume: pnpm db:up / pnpm db:down
STORE_DRIVER=json
# STORE_DRIVER=postgres
# DATABASE_URL=postgresql://sorye:sorye@127.0.0.1:15432/sorye
# Optional Compose overrides (set in repo-root .env before `pnpm db:up`):
# POSTGRES_BIND_ADDRESS=127.0.0.1
# POSTGRES_PORT=15432
# POSTGRES_USER=sorye
# POSTGRES_PASSWORD=sorye
# POSTGRES_DB=sorye
# To connect to a different PostgreSQL instance, change DATABASE_URL and restart
# Hub. Do not use production credentials for local query tests.
#
# OCR → Qwen/Qwen3-8B (compose profile `qwen`, port 8000).
# Hub calls this server-side. Allowed hosts: localhost, 127.0.0.1, ::1,
# qwen3, host.docker.internal. From a Hub container use http://qwen3:8000.
# All three OCR_LLM_* values must be set in the Hub environment; no defaults.
# Missing/invalid settings or an offline server skip the LLM and retain rows.
# OCR_LLM_BASE_URL=http://127.0.0.1:8000
# OCR_LLM_MODEL=Qwen/Qwen3-8B
# OCR_LLM_PROVIDER=vllm
# For a local 12 GB GPU: docker compose --profile qwen-local up -d qwen-local
# Then: docker exec sorye-qwen-local ollama pull qwen3:8b
# OCR_LLM_PROVIDER=ollama
# OCR_LLM_BASE_URL=http://127.0.0.1:8000
# OCR_LLM_MODEL=qwen3:8b
# Local NVIDIA host only; requires nvidia-smi, rejects low VRAM / high temperature.
# OCR_GPU_GUARD=true
#
# Fly.io (set via `fly secrets set`, not in this file):
#   STORE_DRIVER=postgres
#   DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Micro-frontend remote override (optional)
NEXT_PUBLIC_DASHBOARD_REMOTE=http://localhost:3001/remoteEntry.js
NEXT_PUBLIC_CALENDAR_REMOTE=http://localhost:3003/remoteEntry.js
NEXT_PUBLIC_NOTES_REMOTE=http://localhost:3004/remoteEntry.js
NEXT_PUBLIC_TASKS_REMOTE=http://localhost:3005/remoteEntry.js
NEXT_PUBLIC_RELAY_REMOTE=http://localhost:3006/remoteEntry.js
NEXT_PUBLIC_PROTOCOLIO_REMOTE=http://localhost:3007/remoteEntry.js
NEXT_PUBLIC_CANVAS_REMOTE=http://localhost:3008/remoteEntry.js
NEXT_PUBLIC_DEVKIT_REMOTE=http://localhost:3009/remoteEntry.js
NEXT_PUBLIC_MESSENGER_REMOTE=http://localhost:3010/remoteEntry.js
NEXT_PUBLIC_OCR_REMOTE=http://localhost:3011/remoteEntry.js
NEXT_PUBLIC_STUDIO_REMOTE=http://localhost:3012/remoteEntry.js

# Protocolio PDF API (developer bridge — Hub holds the Bearer token)
# Run Protocolio API on 3100 when Sorye Hub already uses 3000:
#   PORT=3100 DEV_TOKEN=local-dev-token  (in D:\projects\protocolio)
PROTOCOLIO_API_URL=http://127.0.0.1:3100
PROTOCOLIO_DEV_TOKEN=local-dev-token

# Feature flags (local dev)
# Rodrigo server connection: required for sign-in/workspace resolution and migrated apps,
# including Site, Drive, Tasks, Notes, Calendar, Canvas, Messenger, Forms and Storefront.
# AUTH_DEV_BYPASS skips Google only; it still needs a healthy configured Rodrigo.
# Set all three values in apps/hub/.env.local. Server-only; never NEXT_PUBLIC.
RODRIGO_BASE_URL=http://127.0.0.1:8088
RODRIGO_KEY_ID=local-v1
RODRIGO_PRIVATE_KEY_FILE=D:/projects/rodrigo/.local/rodrigo/hub-private.pem
# RODRIGO_KEY_ID must match an entry in Rodrigo's RODRIGO_PUBLIC_KEYS_FILE JSON.
# The file above is Hub's Ed25519 private key; Rodrigo receives only its public key.
# Configure Rodrigo separately using its .env.example and deploy/providers.example.json:
# PostgreSQL + SQL migrations, named object storage (objects), service-token keys,
# and a persistent credential-encryption key. See docs/HUB-RODRIGO-ALIGNMENT.md.
# The Docker sandbox uses .local/sandbox/compose.json and mounted keys instead of
# apps/hub/.env.local; do not replace its existing keys when restarting/rebuilding.
# Public address of Rodrigo's /api/v1 (API-key callers). Shown to workspace owners next to
# their keys in Connect → API keys. Not used by Hub for its own calls. https, or loopback http.
# RODRIGO_PUBLIC_API_URL=https://api.sorye.app
# Production requires HTTPS and a mounted private key. dockyard-hub.compose.yml mounts it at /run/secrets/rodrigo_hub_signing_key;
# set RODRIGO_HUB_PRIVATE_KEY_PATH in the host deployment environment to the protected source file.
# Discovery: /api/backend/capabilities and admin-only /api/backend/topology.
# Shared platform configuration (console AI and workers) is stored in Rodrigo; Hub and the
# OCR worker poll it. Default 15000 ms, clamped to 2000-300000.
# PLATFORM_CONFIG_POLL_MS=15000
# RODRIGO_DOCUMENT_OWNERS configures only the separate legacy v1 document migration path; it does not configure v2 actions.
# First freeze/drain every replica, export/import and verify. See docs/RODRIGO.md.
# RODRIGO_DOCUMENT_OWNERS=[{"workspaceId":"WORKSPACE","kind":"tasks","owner":"frozen"}]
# Replace frozen with the verified receipt's owner entry after migration.
# Never remove a migrated owner entry or silently fall back to the old Hub data.
# The current v2 app paths do not require RODRIGO_DOCUMENT_OWNERS or data import.
# Site contact forms also require AUTH_SECRET above (at least 16 characters).
# Logs hub state to the browser console on user interactions.
NEXT_PUBLIC_FEATURE_SHOW_LOGS=false

# Sentry observability (disabled when DSN is empty). Create separate projects
# or DSNs for Hub and browser remotes when app-level dashboards are useful.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Vite remotes read these at build time. Set VITE_SENTRY_DSN in each remote's
# environment (or the shared shell environment) to enable remote telemetry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# Standalone Vite remotes (own port) call Hub with credentials.
# Leave empty when the app is embedded in Hub or /api is same-origin.
# Dev example: http://localhost:3000
# Dev Hub reflects CORS only for http://localhost and http://127.0.0.1 ports.
# Production does not add that CORS policy — serve the remote behind the Hub origin.
VITE_HUB_ORIGIN=

# Mail connected-account IMAP/SMTP passwords are encrypted at rest with
# AUTH_SECRET (same AES-256-GCM helper as workspace database URLs).
# Optional override if you want a dedicated key (min 16 characters):
# MAIL_SECRET_KEY=

# Legacy Hub storage credential encryption only. Current Drive/own-storage and
# Relay cloud-folder credentials are encrypted by Rodrigo's RODRIGO_SECRET_KEY_FILE.
# Generate a dedicated random value of at least 32 characters and keep it in
# your deployment secret manager. Losing it makes saved storage credentials
# unrecoverable.
# STORAGE_SECRET_KEY=

# Legacy Hub blob settings, retained for compatibility checks and unmigrated paths.
# Current Drive and Site media use Rodrigo's provider JSON: storage + objects.
# Configure their S3-compatible credentials in Rodrigo, not FILE_S3_* here.
# The object key is server-generated and scoped by workspace; keep credentials private.
# FILE_STORE_DRIVER=s3
# FILE_S3_BUCKET=
# FILE_S3_REGION=auto
# FILE_S3_ENDPOINT=
# FILE_S3_PATH_STYLE=false

# Embed widgets use AUTH_SECRET to sign short-lived iframe session tokens.
# Create keys in Hub → Connections → Embed widgets.

# Billing. No payment provider is connected yet; /billing shows plans and a contact link.
# Local/test tunnel: BILLING_SIMULATOR=true lets /billing change plans without payment and
# play payment events (failed payment, grace, renewal). Rejected when NODE_ENV=production.
# See docs/SUBSCRIPTIONS.md.
# BILLING_SIMULATOR=true
# Own storage (Relay -> Your storage): Pro/Enterprise workspaces send uploads to their own
# S3-compatible bucket or PostgreSQL through Rodrigo. Requires Rodrigo's persistent
# RODRIGO_SECRET_KEY_FILE; Hub's STORAGE_SECRET_KEY does not configure that key.
# Legacy Hub local/test setting: allows private hosts, HTTP and non-TLS Postgres.
# For Rodrigo's local provider connections use allow_insecure_local in its provider JSON.
# Rejected when NODE_ENV=production. See docs/OWN-STORAGE.md.
# OWN_STORAGE_DEV_INSECURE=true
# Reserved for a future Stripe adapter; unused today.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Playwright E2E (copy to e2e/.env — never commit real values) ────────────
# Authenticated SUSM / ESPM journeys skip if these are empty.
# SUSM login field is E-mail address; ESPM (espm-beta / myespm.eu) is Username.
SUSM_EMAIL=
SUSM_PASSWORD=
ESPM_USERNAME=
ESPM_PASSWORD=
# Defaults are localhost (not Vercel). Override only if your local port differs.
# HUB_URL=http://localhost:3000
# SUSM lives at D:\Martina\app\susm (`ng serve` → :4200). Use localhost, not 127.0.0.1.
# SUSM_URL=http://localhost:4200
# If ESPM already owns :4200: ng serve --port 4201 and set SUSM_URL=http://localhost:4201
# ESPM_URL=http://localhost:4200
# Set to 1 only if you want Playwright to start `pnpm dev` when Hub is down.
# E2E_START_HUB=
# Opt in to remote hosts (Vercel / myespm.eu). Off by default — tests fail if a URL is not localhost.
# ALLOW_LIVE_E2E=
