# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret
AUTH_URL=http://localhost:3000

# Local Hub without Google (recommended for `pnpm dev`).
# Production (Fly.io NODE_ENV=production) refuses this flag and still requires Google OAuth.
AUTH_DEV_BYPASS=true

# Google OAuth — required in production, and locally if AUTH_DEV_BYPASS is not true
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Admin tools (local testing)
ADMIN_SECRET=change-me-in-production-use-openssl-rand
ADMIN_EMAILS=you@gmail.com

# ── Database ────────────────────────────────────────────────────────────────
# Recommended: PostgreSQL (works on Fly.io + local via docker compose)
#
# Local (after `docker compose up -d`):
STORE_DRIVER=json
# DATABASE_URL=postgresql://sorye:sorye@localhost:5432/sorye
#
# Local with Postgres store:
# STORE_DRIVER=postgres
# DATABASE_URL=postgresql://sorye:sorye@localhost:5432/sorye
#
# OCR → Qwen/Qwen3-8B (compose profile `qwen`, port 8000).
# Hub calls this server-side. Allowed hosts: localhost, 127.0.0.1, ::1,
# qwen3, host.docker.internal. From a Hub container use http://qwen3:8000.
# OCR_LLM_BASE_URL=http://127.0.0.1:8000
# OCR_LLM_MODEL=Qwen/Qwen3-8B
# OCR_LLM_PROVIDER=vllm
# For a local 12 GB GPU: docker compose --profile qwen-local up -d qwen-local
# Then: docker exec sorye-qwen-local ollama pull qwen3:8b
# OCR_LLM_PROVIDER=ollama
# OCR_LLM_BASE_URL=http://127.0.0.1:8000
# OCR_LLM_MODEL=qwen3:8b
# Local NVIDIA host only; requires nvidia-smi, rejects low VRAM / high temperature.
# OCR_GPU_GUARD=true
#
# Fly.io (set via `fly secrets set`, not in this file):
#   STORE_DRIVER=postgres
#   DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Micro-frontend remote override (optional)
NEXT_PUBLIC_DASHBOARD_REMOTE=http://localhost:3001/remoteEntry.js
NEXT_PUBLIC_CALENDAR_REMOTE=http://localhost:3003/remoteEntry.js
NEXT_PUBLIC_NOTES_REMOTE=http://localhost:3004/remoteEntry.js
NEXT_PUBLIC_TASKS_REMOTE=http://localhost:3005/remoteEntry.js
NEXT_PUBLIC_RELAY_REMOTE=http://localhost:3006/remoteEntry.js
NEXT_PUBLIC_PROTOCOLIO_REMOTE=http://localhost:3007/remoteEntry.js
NEXT_PUBLIC_CANVAS_REMOTE=http://localhost:3008/remoteEntry.js
NEXT_PUBLIC_DEVKIT_REMOTE=http://localhost:3009/remoteEntry.js
NEXT_PUBLIC_MESSENGER_REMOTE=http://localhost:3010/remoteEntry.js
NEXT_PUBLIC_OCR_REMOTE=http://localhost:3011/remoteEntry.js
NEXT_PUBLIC_STUDIO_REMOTE=http://localhost:3012/remoteEntry.js

# Protocolio PDF API (developer bridge — Hub holds the Bearer token)
# Run Protocolio API on 3100 when Sorye Hub already uses 3000:
#   PORT=3100 DEV_TOKEN=local-dev-token  (in D:\projects\protocolio)
PROTOCOLIO_API_URL=http://127.0.0.1:3100
PROTOCOLIO_DEV_TOKEN=local-dev-token

# Feature flags (local dev)
# Logs hub state to the browser console on user interactions.
NEXT_PUBLIC_FEATURE_SHOW_LOGS=false

# Sentry observability (disabled when DSN is empty). Create separate projects
# or DSNs for Hub and browser remotes when app-level dashboards are useful.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Vite remotes read these at build time. Set VITE_SENTRY_DSN in each remote's
# environment (or the shared shell environment) to enable remote telemetry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# Standalone Vite remotes (own port) call Hub with credentials.
# Leave empty when the app is embedded in Hub or /api is same-origin.
# Dev example: http://localhost:3000
# Dev Hub reflects CORS only for http://localhost and http://127.0.0.1 ports.
# Production does not add that CORS policy — serve the remote behind the Hub origin.
VITE_HUB_ORIGIN=

# Mail connected-account IMAP/SMTP passwords are encrypted at rest with
# AUTH_SECRET (same AES-256-GCM helper as workspace database URLs).
# Optional override if you want a dedicated key (min 16 characters):
# MAIL_SECRET_KEY=

# Embed widgets use AUTH_SECRET to sign short-lived iframe session tokens.
# Create keys in Hub → Connections → Embed widgets.

# Stripe (wire up when billing goes live)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Playwright E2E (copy to e2e/.env — never commit real values) ────────────
# Authenticated SUSM / ESPM journeys skip if these are empty.
# SUSM login field is E-mail address; ESPM (espm-beta / myespm.eu) is Username.
SUSM_EMAIL=
SUSM_PASSWORD=
ESPM_USERNAME=
ESPM_PASSWORD=
# Defaults are localhost (not Vercel). Override only if your local port differs.
# HUB_URL=http://localhost:3000
# SUSM lives at D:\Martina\app\susm (`ng serve` → :4200). Use localhost, not 127.0.0.1.
# SUSM_URL=http://localhost:4200
# If ESPM already owns :4200: ng serve --port 4201 and set SUSM_URL=http://localhost:4201
# ESPM_URL=http://localhost:4200
# Set to 1 only if you want Playwright to start `pnpm dev` when Hub is down.
# E2E_START_HUB=
# Opt in to remote hosts (Vercel / myespm.eu). Off by default — tests fail if a URL is not localhost.
# ALLOW_LIVE_E2E=
