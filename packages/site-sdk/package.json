{
  "name": "@sorye/site-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./render": "./src/render.tsx",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
