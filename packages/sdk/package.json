{
  "name": "@sorye/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./register": {
      "types": "./src/register.ts",
      "import": "./src/register.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "dev": "vite --port 3002",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "lit": "^3.3.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
