  "components": {
    "securitySchemes": {
      "hubAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "EdDSA JWT",
        "description": "iss=sorye-hub, aud=rodrigo, sub, workspaceId, scope, method, path, bodySha256, iat, exp <= iat+30, jti UUID. kid selects trusted public key. TLS required across VMs. Assertions are bearer credentials until expiration; jti is not a distributed replay lock."
      }
    },
    "schemas": {
      "Capabilities": {
        "type": "object",
        "required": [
          "contractVersion",
          "service",
          "dataReady",
          "operations",
          "adapters"
        ],
        "properties": {
          "contractVersion": {
            "const": "1"
          },
          "service": {
            "const": "rodrigo"
          },
          "dataReady": {
            "type": "boolean"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adapters": {
            "type": "object",
            "required": [
              "postgresql",
              "mongodb",
              "redis",
              "s3"
            ],
            "properties": {
              "postgresql": {
                "enum": [
                  "not_implemented",
                  "not_configured",
                  "ready"
                ]
              },
              "mongodb": {
                "enum": [
                  "not_implemented",
                  "not_configured",
                  "ready"
                ]
              },
              "redis": {
                "enum": [
                  "not_implemented",
                  "not_configured",
                  "ready"
                ]
              },
              "s3": {
                "enum": [
                  "not_implemented",
                  "not_configured",
                  "ready"
                ]
              }
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "revision",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WriteDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "payload"
        ],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
}
