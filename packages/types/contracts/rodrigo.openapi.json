{
  "openapi": "3.1.0",
  "info": {
    "title": "Rodrigo service contract",
    "version": "1.0.0",
    "description": "Next.js signs short-lived Ed25519 JWTs bound to HTTP method, exact path, SHA-256 body digest, user, workspace and operation scope. PostgreSQL, MongoDB, Redis and S3 are not implemented. Document routes return adapter_not_configured, never success. Public health readiness means HTTP service ready; dataReady is false."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "Process alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "alive"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "HTTP ready; inspect dataReady independently",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "dataReady": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "dataReady"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "security": [
