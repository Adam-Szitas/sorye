    "/v1/documents/{kind}": {
      "parameters": [
        {
          "name": "kind",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "tasks",
              "notes",
              "calendar"
            ]
          }
        }
      ],
      "get": {
        "operationId": "readDocument",
        "security": [
          {
            "hubAssertion": []
          }
        ],
        "x-required-scope": "documents:read",
        "responses": {
          "200": {
            "description": "Document or null if absent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "document"
                  ],
                  "properties": {
                    "document": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Document"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Stable error code and server-generated request ID",
            "content": {
