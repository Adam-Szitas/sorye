{
  "name": "@sorye/hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "worker:ocr": "tsx lib/workers/ocr-worker.ts",
    "worker:relay": "tsx lib/workers/relay-worker.ts",
    "store:import-json": "tsx lib/tools/import-json-state.ts",
    "files:migrate-blobs": "tsx lib/tools/migrate-file-blobs.ts",
    "test:scalability": "tsx --test test/scalability.test.ts",
    "test:rodrigo": "tsx --test test/rodrigo-contract.test.ts",
    "prebuild": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@module-federation/runtime": "^2.7.0",
    "@sentry/nextjs": "^10.75.1",
    "@sorye/db": "workspace:*",
    "@sorye/platform": "workspace:*",
    "@sorye/sdk": "workspace:*",
    "@sorye/types": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "imapflow": "^2.1.0",
    "import-in-the-middle": "3.5.1",
    "mailparser": "^3.9.29",
    "next": "^15.3.4",
    "next-auth": "5.0.0-beta.29",
    "nodemailer": "^6.10.1",
    "pdfjs-dist": "4.10.38",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "require-in-the-middle": "8.0.1",
    "swr": "^2.3.3",
    "tsx": "^4.23.15",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.32",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  }
}
