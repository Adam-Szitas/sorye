FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_DASHBOARD_REMOTE
ENV NEXT_PUBLIC_DASHBOARD_REMOTE=${NEXT_PUBLIC_DASHBOARD_REMOTE}
ARG NEXT_PUBLIC_CALENDAR_REMOTE
ENV NEXT_PUBLIC_CALENDAR_REMOTE=${NEXT_PUBLIC_CALENDAR_REMOTE}
ARG NEXT_PUBLIC_NOTES_REMOTE
ENV NEXT_PUBLIC_NOTES_REMOTE=${NEXT_PUBLIC_NOTES_REMOTE}
ARG NEXT_PUBLIC_TASKS_REMOTE
ENV NEXT_PUBLIC_TASKS_REMOTE=${NEXT_PUBLIC_TASKS_REMOTE}
ARG NEXT_PUBLIC_RELAY_REMOTE
ENV NEXT_PUBLIC_RELAY_REMOTE=${NEXT_PUBLIC_RELAY_REMOTE}
ARG NEXT_PUBLIC_PROTOCOLIO_REMOTE
ENV NEXT_PUBLIC_PROTOCOLIO_REMOTE=${NEXT_PUBLIC_PROTOCOLIO_REMOTE}
ARG NEXT_PUBLIC_CANVAS_REMOTE
ENV NEXT_PUBLIC_CANVAS_REMOTE=${NEXT_PUBLIC_CANVAS_REMOTE}
ARG NEXT_PUBLIC_DEVKIT_REMOTE
ENV NEXT_PUBLIC_DEVKIT_REMOTE=${NEXT_PUBLIC_DEVKIT_REMOTE}
ARG NEXT_PUBLIC_MESSENGER_REMOTE
ENV NEXT_PUBLIC_MESSENGER_REMOTE=${NEXT_PUBLIC_MESSENGER_REMOTE}
ARG NEXT_PUBLIC_OCR_REMOTE
ENV NEXT_PUBLIC_OCR_REMOTE=${NEXT_PUBLIC_OCR_REMOTE}
ARG NEXT_PUBLIC_STUDIO_REMOTE
ENV NEXT_PUBLIC_STUDIO_REMOTE=${NEXT_PUBLIC_STUDIO_REMOTE}
RUN pnpm --filter @sorye/hub... build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/apps/hub/.next/standalone ./
COPY --from=build /app/apps/hub/.next/static ./apps/hub/.next/static
COPY --from=build /app/apps/hub/public ./apps/hub/public
EXPOSE 3000
CMD ["node", "apps/hub/server.js"]
