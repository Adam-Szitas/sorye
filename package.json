{
  "name": "sorye",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@sorye/hub --filter=@sorye/dashboard",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:hub": "turbo dev --filter=@sorye/hub",
    "dev:dashboard": "turbo dev --filter=@sorye/dashboard",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @sorye/db db:push",
    "db:studio": "pnpm --filter @sorye/db db:studio",
    "dev:sdk": "pnpm --filter @sorye/sdk dev"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  }
}
